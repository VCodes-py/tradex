# Copy to server/.env and fill in.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/tradex

# Required in production. Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated list of browser origins allowed to call the API.
CLIENT_ORIGIN=http://localhost:5173

# Optional fallback providers. Yahoo Finance is used first and needs no key.
# Twelve Data (free key): https://twelvedata.com/pricing
TWELVEDATA_API_KEY=
# CoinGecko demo key (optional, raises rate limits): https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# How long a quote is cached, in seconds.
QUOTE_TTL_SECONDS=30
